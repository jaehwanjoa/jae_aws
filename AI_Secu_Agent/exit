+def save_filename_index(
+    file_name,
+    sha256,
+    incident_id
+):
+
+    try:
+
+        data = {}
+
+        try:
+
+            obj = s3_client.get_object(
+                Bucket=S3_BUCKET,
+                Key="wf-index.json"
+            )
+
+            data = json.loads(
+                obj["Body"].read()
+            )
+
+        except Exception:
+

+        )
+
+
+def lookup_filename_index(
+    file_name
+):
+
+    try:
+
+        obj = s3_client.get_object(
+            Bucket=S3_BUCKET,
+            Key="wf-index.json"
+        )
+
+        data = json.loads(
+            obj["Body"].read()
+        )
+
+        return data.get(
+            file_name.lower()
+        )
+
+    except Exception as e:
+
+        print(
+            f"S3_LOOKUP_ERROR={e}"

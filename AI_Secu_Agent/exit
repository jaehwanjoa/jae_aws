+
+        data[file_name.lower()] = {
+            "sha256": sha256,
+            "incident_id": incident_id
+        }
+
+        s3_client.put_object(
+            Bucket=S3_BUCKET,
+            Key="wf-index.json",
+            Body=json.dumps(
+                data,
+                ensure_ascii=False
+            )
+        )
+
+        print(
+            f"S3_INDEX_SAVE={file_name}"
